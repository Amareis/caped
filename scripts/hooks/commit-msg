#!/usr/bin/env bash
# caped v0 commit-msg hook: registry-driven.
#
# Every commit touching files of an `enforced` capability must DECLARE its
# change class via a git trailer:
#
#   Behavior: contract   — a requirement changed; add  Spec: <path> (or touch the cap's spec file)
#   Behavior: internal   — refactor/bugfix/typo, no contract change
#   Behavior: wip        — intermediate commit inside a change
#
# A subject starting with "wip" counts as `Behavior: wip`.
# Commits touching no enforced capability need no trailer.
#
# Tracker events (repo-global, ideas/ + changes/ live outside the caps registry):
#
#   A  ideas/<name>.md                  needs  Idea: <name>
#   R  ideas/<name>.md -> changes/…     needs  Change: <name>   (a change is born ONLY via rename)
#   M  changes/<name>.md                needs  Change: <name>
#   M  ideas/<name>.md                  needs  Idea: <name>   (idea edits mirror change edits;
#                                                                 ideas/_backlog.md and idea-rename commits exempt)
#   D  changes/<name>.md                needs  Archives: <name>
#
# `Change: <name>` requires changes/<name>.md to exist (except `Change: init` and
# the archival commit itself); `Archives: <name>` requires the deletion in the same commit.
#
# A fileless `Behavior: contract` (no Change:) is an adhoc decision: it must carry
# both an `Adhoc: <name>` trailer (the commit messages ARE the change doc; commits
# sharing the name form one change) and its rationale in the body.
# All violations (events + caps) are reported
# in one aggregated message. Overlapping registry prefixes: longest prefix wins.
#
# Registry: caped.registry at the repo root, one line per capability:
#   name <TAB> path-prefix <TAB> state(legacy|declared|enforced) <TAB> spec-file
#
# Installed by scripts/caped-init.sh via a shim in .git/hooks/commit-msg.

set -euo pipefail

MSG_FILE="$1"
ROOT="$(git rev-parse --show-toplevel)"
REGISTRY="$ROOT/caped.registry"

[ -f "$REGISTRY" ] || exit 0

# Merge commits are exempt.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    exit 0
fi

SUBJECT="$(head -1 "$MSG_FILE")"
TRAILERS="$(git interpret-trailers --parse "$MSG_FILE")"
BEHAVIOR="$(printf '%s\n' "$TRAILERS" | sed -n 's/^Behavior: //p' | head -1 || true)"
if printf '%s' "$SUBJECT" | grep -qiE '^wip\b'; then
    BEHAVIOR="${BEHAVIOR:-wip}"
fi

# --- Tracker events: ideas/ + changes/ are repo-global, checked for every commit ---
IDEA="$(printf '%s\n' "$TRAILERS" | sed -n 's/^Idea: //p' | head -1 || true)"
CHANGE="$(printf '%s\n' "$TRAILERS" | sed -n 's/^Change: //p' | head -1 || true)"
ARCHIVES="$(printf '%s\n' "$TRAILERS" | sed -n 's/^Archives: //p' | head -1 || true)"
ADHOC="$(printf '%s\n' "$TRAILERS" | sed -n 's/^Adhoc: //p' | head -1 || true)"
IDEAS_ALL="$(printf '%s\n' "$TRAILERS" | sed -n 's/^Idea: //p' || true)"

EVENT_ERRORS=""
err() { EVENT_ERRORS="${EVENT_ERRORS}$1
"; }

NS_ALL="$(git diff --cached --name-status -M)"
# An idea-rename commit (mv + referrer fixes across ideas/) is governed by the
# rename rule, not the edit rule — its M ideas/*.md need no Idea: trailer.
RENAMES="$(printf '%s\n' "$NS_ALL" | grep -E '^R[0-9]*\tideas/[^\t]*\.md\tideas/[^\t]*\.md$' || true)"
# Multi-idea commits (A or M of >=2 idea files, minus _backlog and rename
# commits) are two semantic events — reject with an honest "split" message,
# not a lying per-file "trailer required" (the trailer may be present, just not
# first). Single-idea checks below match against ALL Idea: trailers.
IDEA_TOUCHES="$(printf '%s\n' "$NS_ALL" | grep -E '^(A|M)\tideas/[^\t]+\.md$' | grep -Ev $'^(A|M)\tideas/_backlog\.md$' || true)"
IDEA_COUNT="$(printf '%s\n' "$IDEA_TOUCHES" | sed '/^$/d' | wc -l | tr -d ' ')"
[ -n "$IDEA_COUNT" ] || IDEA_COUNT=0
if [ "$IDEA_COUNT" -gt 1 ] && [ -z "$RENAMES" ]; then
    err "commit touches $IDEA_COUNT idea files — one idea per commit (one semantic event = one commit): split into separate commits"
fi

while IFS=$'\t' read -r status p1 p2; do
    case "$status" in
        A)
            case "$p1" in
                ideas/*.md)
                    want="$(basename "$p1" .md)"
                    if ! printf '%s\n' "$IDEAS_ALL" | grep -qxF "$want"; then
                        err "new idea $p1 — trailer required: Idea: $want"
                    fi
                    ;;
                changes/*.md)
                    [ "$CHANGE" = "init" ] || err "change $p1 added directly — taking an idea into work is a clean 'git mv ideas/<name>.md changes/<name>.md' with trailer Change: <name>"
                    ;;
            esac
            ;;
        R*)
            case "$p1/$p2" in
                ideas/*.md/changes/*.md)
                    src="$(basename "$p1" .md)"; want="$(basename "$p2" .md)"
                    [ "$src" = "$want" ] || err "rename $p1 -> $p2 changes the name — mv into work keeps the file name"
                    [ "$CHANGE" = "$want" ] || err "taking $p2 into work — trailer required: Change: $want"
                    ;;
            esac
            ;;
        M)
            case "$p1" in
                changes/*.md)
                    want="$(basename "$p1" .md)"
                    [ "$CHANGE" = "$want" ] || err "edit of change $p1 — trailer required: Change: $want"
                    ;;
                ideas/_backlog.md)
                    : ;;  # service pseudo-idea: _backlog maintenance and archive deposits are not idea edits
                ideas/*.md)
                    if [ -z "$RENAMES" ]; then
                        want="$(basename "$p1" .md)"
                        if ! printf '%s\n' "$IDEAS_ALL" | grep -qxF "$want"; then
                            err "edit of idea $p1 — trailer required: Idea: $want (mirrors Change: on change edits; _backlog and idea-rename commits are exempt)"
                        fi
                    fi
                    ;;
            esac
            ;;
        D)
            case "$p1" in
                changes/*.md)
                    want="$(basename "$p1" .md)"
                    [ "$ARCHIVES" = "$want" ] || err "deletion of change $p1 — trailer required: Archives: $want"
                    ;;
                ideas/*.md)
                    want="$(basename "$p1" .md)"
                    [ "$ARCHIVES" = "$want" ] || err "deletion of idea $p1 — trailer required: Archives: $want (idea archived/withdrawn; references keep resolving)"
                    ;;
            esac
            ;;
    esac
done <<< "$NS_ALL"

# Change: must reference an existing change (except the init seed and the archival commit)
if [ -n "$CHANGE" ] && [ "$CHANGE" != "init" ] && [ -z "$ARCHIVES" ]; then
    git ls-files --error-unmatch "changes/$CHANGE.md" >/dev/null 2>&1 ||
        err "trailer Change: $CHANGE, but changes/$CHANGE.md does not exist (take the idea into work via mv first)"
fi
# Archives: requires the file deletion in the same commit
if [ -n "$ARCHIVES" ] && ! git diff --cached --name-status | grep -qE "^D\t(changes|ideas)/$ARCHIVES\.md$"; then
    err "trailer Archives: $ARCHIVES, but neither changes/$ARCHIVES.md nor ideas/$ARCHIVES.md is deleted in this commit"
fi
# Question-lifecycle gate: deferred ("later/v0.1/отложено") open questions at
# archive must be answered, promoted ("промоут → X" in the change file) or
# deposited into ideas/_backlog.md (a line naming the change IN THIS COMMIT).
if [ -n "$ARCHIVES" ]; then
    OLDQ="$(git show "HEAD:changes/$ARCHIVES.md" 2>/dev/null || true)"
    FUTURE="$(printf '%s\n' "$OLDQ" | sed -n '/^## Open questions/,/^## /p' | grep -E 'v0\.1|позже|отлож|будущ|следующ' || true)"
    if [ -n "$FUTURE" ]; then
        PROMOTED="$(printf '%s\n' "$OLDQ" | grep 'промоут →' || true)"
        DEPOSIT="$(git diff --cached -- ideas/_backlog.md | grep -E "\b$ARCHIVES\b" || true)"
        if [ -z "$PROMOTED" ] && [ -z "$DEPOSIT" ]; then
            err "archiving $ARCHIVES with deferred open questions — answer/promote them ('промоут → X' in the file) or deposit them into ideas/_backlog.md (a line naming $ARCHIVES in this commit)"
        fi
    fi
fi

CHANGED="$(git diff --cached --name-only)"

# Does the commit touch an enforced capability? Longest prefix wins.
CAP_SPEC=""
CAP_NAME=""
while IFS=$'\t' read -r name prefix state spec; do
    case "$name" in '' | \#*) continue ;; esac
    [ "$state" = "enforced" ] || continue
    if printf '%s\n' "$CHANGED" | grep -q "^$prefix"; then
        CAP_NAME="$name"
        CAP_SPEC="$spec"
        break
    fi
done < <(awk -F'\t' 'NF { print length($2) "\t" $0 }' "$REGISTRY" | sort -rn | cut -f2-)

if [ -n "$CAP_NAME" ]; then
    if [ -z "$BEHAVIOR" ]; then
        err "touches enforced capability '$CAP_NAME' without a change class — add a trailer: Behavior: contract + Spec: $CAP_SPEC (or \"Behavior: internal\" for a no-contract-change fix, \"Behavior: wip\" for an intermediate commit)"
    else
        case "$BEHAVIOR" in
            wip | internal) : ;;
            contract)
                SPEC_TRAILER="$(printf '%s\n' "$TRAILERS" | sed -n 's/^Spec: //p' | head -1 || true)"
                if [ -z "$SPEC_TRAILER" ] && ! printf '%s\n' "$CHANGED" | grep -qx "$CAP_SPEC"; then
                    err "Behavior: contract needs a Spec: trailer or a change to $CAP_SPEC in the commit"
                fi
                # Fileless contract (no Change:) is an adhoc decision: it needs an
                # Adhoc: <name> trailer (the messages ARE the change doc; a shared name
                # clusters the commits into one change) and a rationale body — subject
                # and the actual trailer block (as parsed by git, not just trailer-LOOKING
                # lines) don't count.
                TRAILER_BLOCK="$(git interpret-trailers --only-trailers "$MSG_FILE" || true)"
                BODY="$(tail -n +2 "$MSG_FILE" | grep -vxF -f <(printf '%s\n' "$TRAILER_BLOCK") | sed '/^#/d; /^[[:space:]]*$/d' || true)"
                if [ -z "$CHANGE" ]; then
                    [ -n "$ADHOC" ] || err "fileless contract (no Change:) is an adhoc decision — add a trailer: Adhoc: <name> (the commit messages ARE the change doc; commits sharing the name form one change)"
                    [ -n "$BODY" ] || err "fileless contract (no Change:) is an adhoc decision — the commit body must carry the mini-provenance (what, why, on what grounds)"
                fi
                ;;
            *)
                err "unknown Behavior value '$BEHAVIOR' (expected contract|internal|wip)"
                ;;
        esac
    fi
fi

if [ -n "$EVENT_ERRORS" ]; then
    # rejected-commit visibility: the rejection itself is a feed fact (written
    # by the gate while it stays BEFORE — notification vs enforcement).
    mkdir -p "$ROOT/.caped/events" 2>/dev/null || true
    # The rejection reasons ride along as m: (single-line JSON-escaped) so the
    # fact stays useful when the hook's stderr is lost (pipes, truncation).
    MSG="$(printf '%s' "$EVENT_ERRORS" | perl -0777 -pe 's/\\/\\\\/g; s/"/\\"/g; s/\n/\\n/g' | head -c 500 || true)"
    printf '{"t":"commit-rejected","e":"%s","c":"%s","m":"%s","at":"%s"}\n' \
      "${ARCHIVES:-}${IDEA:-}${CHANGE:-}" \
      "$(git rev-parse --short HEAD 2>/dev/null || echo -)" \
      "$MSG" \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$ROOT/.caped/events/feed.jsonl" 2>/dev/null || true
    crhook="$ROOT/.caped/hooks/commit-rejected"
    if [ -x "$crhook" ]; then
      CAPED_EVENT="commit-rejected" CAPED_ROOT="$ROOT" "$crhook" || true
    fi
    printf 'commit-msg: rule violations:\n%s' "$EVENT_ERRORS" >&2
    exit 1
fi
exit 0
